# ─────────────────────────────────────────────────────────────────────────────
# gatekeeper-suite — variáveis de ambiente (copie para .env e preencha)
# NUNCA versione o .env real. Todos os valores abaixo são placeholders vazios.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gatekeeper: backends LLM (guardião de permissões) ────────────────────────
# Cadeia ordenada de backends (o primeiro que responder decide). Ex.: gemini,ollama
GATEKEEPER_BACKEND=ollama
GATEKEEPER_BACKEND_CHAIN=
GATEKEEPER_FALLBACK_BACKEND=ollama
GATEKEEPER_FALLBACK_ENABLED=true

# Chaves de API (obtenha grátis: Cerebras, Gemini; OpenRouter tem free tier)
GATEKEEPER_CEREBRAS_API_KEY=
GATEKEEPER_CEREBRAS_MODEL=gpt-oss-120b
GATEKEEPER_GEMINI_API_KEY=
GATEKEEPER_GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
GATEKEEPER_OPENROUTER_MODEL=openai/gpt-oss-120b:free
GATEKEEPER_CUSTOM_URL=
GATEKEEPER_CUSTOM_API_KEY=
GATEKEEPER_CUSTOM_MODEL=

# Fallback headless: usa `claude -p` (CONSOME o limite da conta). O Governor
# faz o gatekeeper pular este fallback durante uma pausa (§ integração).
GATEKEEPER_CLAUDE_HEADLESS=true
GATEKEEPER_SMART_REVIEW=true
GATEKEEPER_FAILOPEN_MAX_RISK=medium

# ── Ask remoto (opcional) — Telegram, reusado pelo Governor ──────────────────
# Habilita perguntas/avisos remotos. Deixe vazio para desabilitar.
GATEKEEPER_REMOTE=            # "telegram" para habilitar
GATEKEEPER_REMOTE_TOKEN=      # bot token do Telegram
GATEKEEPER_REMOTE_CHAT_ID=    # chat_id autorizado (única origem aceita)
GATEKEEPER_REMOTE_TIMEOUT=60

# ── Governor: monitor de limite de uso (todos têm defaults conservadores) ────
# Descomente só o que quiser sobrescrever.
# GOVERNOR_MONITORING_INTERVAL_MS=30000
# GOVERNOR_MAXIMUM_USAGE_PERCENTAGE=95
# GOVERNOR_MINIMUM_AVAILABLE_PERCENTAGE_TO_RESUME=50
# GOVERNOR_SAFETY_MARGIN_MS=120000
# GOVERNOR_BURN_RATE_WINDOW_MS=600000
# GOVERNOR_RESET_CHECK_INTERVAL_MS=15000
# GOVERNOR_HOOK_WAIT_TIMEOUT_MS=21000000
